{
  "name": "the-sheep-are-angry",
  "private": true,
  "description": "A top-down survival game where you play a sheep.",
  "scripts": {
    "test": "node --test tests/",
    "build": "node tools/build-single.mjs",
    "export-data": "node tools/export-data.mjs",
    "format": "npx prettier@3.3.3 --write \"src/**/*.js\" \"tests/**/*.mjs\" \"tools/**/*.mjs\" css/game.css",
    "serve": "python3 -m http.server 8000"
  }
}
